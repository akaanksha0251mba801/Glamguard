# GEMINI_API_KEY: Required for server-side Gemini AI Beauty Rescue Plan generation.
# In AI Studio: configured automatically via Secrets panel.
# In Vercel: add under Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where GlamGuard is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase Web Config overrides for Vercel / external hosting
# (By default, GlamGuard reads from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
