{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private beauty profile, preferences, and owned products for a GlamGuard user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "ageRange": {
          "type": "string",
          "maxLength": 40
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "skinType": {
          "type": "string",
          "maxLength": 40
        },
        "hairType": {
          "type": "string",
          "maxLength": 80
        },
        "makeupPreference": {
          "type": "string",
          "maxLength": 40
        },
        "beautyConcerns": {
          "type": "array",
          "description": "Self-reported primary beauty concerns (max 15)."
        },
        "budgetPreference": {
          "type": "string",
          "maxLength": 40
        },
        "existingProducts": {
          "type": "array",
          "description": "User-owned skincare, makeup, and haircare items (max 40)."
        },
        "productPreferences": {
          "type": "string",
          "maxLength": 500
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "onboardingCompleted", "createdAt", "updatedAt"]
    },
    "RescuePlan": {
      "title": "RescuePlan",
      "description": "A saved personalized Beauty Rescue Plan generated by Gemini AI.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "occasion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "concerns": {
          "type": "array",
          "description": "Selected beauty concerns (max 20)."
        },
        "customConcern": {
          "type": "string",
          "maxLength": 400
        },
        "availableTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "availableMinutes": {
          "type": "number"
        },
        "situation": {
          "type": "object",
          "description": "User situation flags (environment, weather, awayFromHome, washroomAccess, hasProducts, productSource)."
        },
        "generatedPlan": {
          "type": "object",
          "description": "Structured Beauty Rescue Plan output from Gemini AI."
        },
        "feedbackRating": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "occasion", "concerns", "availableTime", "availableMinutes", "situation", "generatedPlan", "createdAt"]
    },
    "PlanFeedback": {
      "title": "PlanFeedback",
      "description": "Pilot user validation feedback for a generated Beauty Rescue Plan.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "maxLength": 128
        },
        "usefulness": {
          "type": "number"
        },
        "relevance": {
          "type": "number"
        },
        "easeOfUse": {
          "type": "number"
        },
        "timeFit": {
          "type": "boolean"
        },
        "reuseIntent": {
          "type": "string",
          "maxLength": 40
        },
        "writtenFeedback": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "planId", "usefulness", "relevance", "easeOfUse", "timeFit", "reuseIntent", "createdAt"]
    },
    "PricingResponse": {
      "title": "PricingResponse",
      "description": "Willingness-to-pay validation response for the proposed ₹99/month GlamGuard plan.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "proposedPrice": {
          "type": "number"
        },
        "willingnessToPay": {
          "type": "string",
          "maxLength": 40
        },
        "response": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "proposedPrice", "willingnessToPay", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user beauty profile and owned product inventory, readable and writable only by the owner."
    },
    "/users/{userId}/plans/{planId}": {
      "schema": { "$ref": "#/entities/RescuePlan" },
      "description": "Saved Beauty Rescue Plans belonging strictly to userId."
    },
    "/users/{userId}/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/PlanFeedback" },
      "description": "Pilot feedback submissions belonging strictly to userId."
    },
    "/users/{userId}/pricingResponses/{responseId}": {
      "schema": { "$ref": "#/entities/PricingResponse" },
      "description": "Willingness-to-pay responses for the proposed ₹99/month tier belonging strictly to userId."
    }
  }
}
